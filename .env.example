# =============================================================================
# Distributed Fault-Tolerant Payment System - Environment Configuration Template
# =============================================================================

# Application Profiles (dev = fast in-memory H2; prod = real PostgreSQL + Flyway)
SPRING_PROFILES_ACTIVE=prod

# Server Configuration
SERVER_PORT=8080

# -----------------------------------------------------------------------------
# REAL POSTGRESQL CONFIGURATION (Production / Cloud Deployment)
# -----------------------------------------------------------------------------
# Option A: Universal Cloud DATABASE_URL (automatically parsed for Neon, Supabase, Render)
# - Neon:     DATABASE_URL=postgresql://user:password@ep-cool-fog-1234.us-east-2.aws.neon.tech/neondb?sslmode=require
# - Supabase: DATABASE_URL=postgresql://postgres.projectid:password@aws-0-us-west-1.pooler.supabase.com:6543/postgres
# - Render:   DATABASE_URL=postgresql://user:password@dpg-abc1234-a.oregon-postgres.render.com/apexpay_db
DATABASE_URL=

# Option B: Standard Spring Boot JDBC Datasource Properties
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/payment_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres_secret

# HikariCP Connection Pool
HIKARI_MAX_POOL_SIZE=20
HIKARI_MIN_IDLE=5

# -----------------------------------------------------------------------------
# APPLICATION SECURITY & CREDENTIALS
# -----------------------------------------------------------------------------
# System API Key for authenticating clients
API_KEY=apexpay_admin_secret_key_2026

# Cursor Pagination HMAC Signing Key
PAGINATION_SIGNING_SECRET=apexpay_cursor_signing_secret_prod_2026

# Feature Flags
LEDGER_ENABLED=true

# MongoDB Configuration (Optional Audit Log Store)
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/payment_audit_db

# Streamlit Dashboard Configuration
BACKEND_API_URL=http://localhost:8080
STREAMLIT_SERVER_PORT=8501
